  "cards": [
    { "dot": "rose", "title": "Authentication", "items": [
      "proxy.ts middleware redirects unauthenticated /app and /check requests to /auth/sign-in",
      "Client fetches /api/auth/token, caches it until 30s before exp, and retries once on a 401",
      "Backend decodes the EdDSA JWT with issuer and audience set to the Neon Auth origin; sub becomes the user id"
    ] },
    { "dot": "emerald", "title": "Check lifecycle", "items": [
      "POST /api/checks accepts one PDF (≤20 MB, %PDF header) or text (≤120,000 chars), inserts a queued row, returns 202",
      "run_check moves the row through extracting → searching → verifying → done, or failed with a public error",
      "Claims are processed two at a time; each queries google, google_news and google_scholar in parallel with one retry"
    ] },
    { "dot": "violet", "title": "Evidence memory", "items": [
      "Claim text is embedded with gemini-embedding-001 (768-d) and prior chunks are retrieved by cosine ≥ 0.55 from the same user's other checks",
      "Evidence snippets are embedded and inserted into evidence_chunks with ON CONFLICT DO NOTHING",
      "Verdicts are grounded in live search evidence; prior evidence is supplemental context only"
    ] },
    { "dot": "amber", "title": "Report", "items": [
      "Freshness score averages weights: current 100, outdated 55, unverifiable 35, contradicted 15",
      "Report page exports corrected notes, a changelog and flashcards entirely client-side"
    ] }
  ]
